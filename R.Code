 ####### H O M E F I E L D    A D V A N T A G E    I N D I C E S #######

#Load the data for HFAI values
MassHFAI<-read_excel("data/Ch2_GPD/MassLoss_HFAI.xlsx")

##Getting to know you...♩ Getting to know all about you...♫
summary(MassHFAI) #view a summary of the data (median, quartiles, etc.)
dim(MassHFAI) #dimensions
str(MassHFAI) #Structure. What are the variables? 
head(MassHFAI)


library(dplyr)
library(ggplot2)

# Make sure Month is ordered correctly for plotting
MassHFAI <- MassHFAI %>%
  mutate(
    Month = as.numeric(as.character(Month)),  # if Month is a factor like "2","6","12","18"
    Mesh  = factor(Mesh) )

MassHFAI_D18 <- subset(MassHFAI, Month == 18)

hfai_sum_sp <- MassHFAI_D18 %>%
  filter(!is.na(HFAI)) %>%
  group_by(Species, Mesh) %>%
  summarise(
    n = n(),
    mean_HFAI = mean(HFAI),
    se_HFAI = sd(HFAI)/sqrt(n),
    .groups="drop"
  )
library(dplyr)
library(ggplot2)

# Make Mesh labels consistent (edit levels/labels if yours are already "Coarse"/"Fine")
MassHFAI_D18 <- MassHFAI_D18 %>%
  mutate(
    Mesh = as.character(Mesh),
    Mesh = ifelse(Mesh %in% c("C", "Coarse"), "Coarse",
                  ifelse(Mesh %in% c("F", "Fine"), "Fine", Mesh)),
    Mesh = factor(Mesh, levels = c("Coarse", "Fine"))
  )

# Recompute summary (so it matches the cleaned Mesh labels)
hfai_sum <- MassHFAI_D18 %>%
  filter(!is.na(HFAI)) %>%
  group_by(Mesh) %>%
  summarise(n = n(), mean_HFAI = mean(HFAI, na.rm = TRUE),
    se_HFAI   = sd(HFAI, na.rm = TRUE) / sqrt(n), .groups = "drop")


#HFAI Boxplot
ggplot(MassHFAI_D18, aes(x = Mesh, y = HFAI)) +
  geom_hline(yintercept = 0, linetype = "dashed", linewidth = 0.9,
             color = "darkred") +# zero reference line = no HFA
  geom_boxplot(width = 0.5,outlier.shape = NA, linewidth = 0.8,
    fill = "thistle4", color = "black" ) +
  geom_point(position = position_jitter(width = 0.12),
    size = 3, alpha = 0.7, color = "black" ) +
  labs(x = "Mesh size", y = "Home-field advantage index (HFAI)") +
  theme_classic() +
  theme(
    axis.title = element_text(size = 28, color = "black"),
    axis.text  = element_text(size = 26, color = "black"),
    axis.line  = element_line(linewidth = 1),
    axis.ticks = element_line(linewidth = 1),
    legend.position = "none")

HFAI <- lm(HFAI ~ Mesh * Month , data = MassHFAI)
anova(HFAI)
