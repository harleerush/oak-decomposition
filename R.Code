## Leaf physical traits
Phys <- read_excel("data/Geauga_LeafThickSA_PinVSRed.xlsx")
dim(Phys)
summary(Phys)
View(Phys)

Phys_summary <- Phys %>%
  group_by(Species) %>%
  summarise(
    n = n(),
    
    mean_Thickness = mean(Thickness, na.rm = TRUE),
    se_Thickness = sd(Thickness, na.rm = TRUE) / sqrt(n),
    
    mean_SA = mean(SA, na.rm = TRUE),
    se_SA = sd(SA, na.rm = TRUE) / sqrt(n),
    
    mean_SLA = mean(SLA, na.rm = TRUE),
    se_SLA = sd(SLA, na.rm = TRUE) / sqrt(n)
  )

View(Phys_summary)



t.test(Thickness ~ Species, data = Phys)
t.test(SA ~ Species, data = Phys)
t.test(SLA ~ Species, data = Phys)

#------------------------------------------------------------------------------#

View(MassK)

MassK <- MassK %>%
  mutate(
    Home = case_when(
      Species == "Pin" & Habitat == "Lowland" ~ "Home",
      Species == "Pin" & Habitat == "Upland"     ~ "Away",
      Species == "Red"     & Habitat == "Upland"     ~ "Home",
      Species == "Red"     & Habitat == "Lowland" ~ "Away",
      TRUE ~ NA_character_
    ),
    Home  = factor(Home, levels = c("Away","Home")),
    Month = factor(Month, levels = sort(unique(Month))),
    Mesh  = factor(Mesh)
  )

MassK$logMassLoss <- log(MassK$PercMassLoss + 1)

mod_hfa <- lmer(logMassLoss ~ Month * Mesh * Home + (1 | Park/Rep),
  data = MassK)
summary(mod_hfa)

emm <- emmeans(mod_hfa, ~ Home | Month * Mesh)
emm
hfa <- as.data.frame(contrast(emm, method = "revpairwise"))  # Home - Away
hfa
hfa_ci <- hfa %>%
  mutate(
    tcrit = qt(0.90, df),
    lower.CL = estimate - tcrit * SE,
    upper.CL = estimate + tcrit * SE
  )

ggplot(hfa_ci, aes(x = Month, y = estimate, fill = Mesh)) +
  geom_bar(stat="identity", position=position_dodge(0.8),
           width=0.7, color="black") +
  geom_errorbar(aes(ymin = lower.CL, ymax = upper.CL),
                position = position_dodge(0.8), width = 0.2) +
  geom_hline(yintercept=0, color="red", linewidth=0.8) +
  scale_fill_manual(values = c("C"="black","F"="grey70"),
                    labels = c("Coarse","Fine")) +
  labs(x="Month", y="Estimated HFA (Home − Away) (80% CI)", fill="Mesh") +
  theme_classic()
