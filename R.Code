##Initial chemistry

Chemistry <- read_excel("data/AllData_with chemicals_ALL.samples.xlsx")
summary(Chemistry)
dim(Chemistry) #596 x 95


InitialChem <- Chemistry %>% filter(Month == 0)
InitialChem$CN <- InitialChem$PercCarb / InitialChem$PercNit
View(InitialChem)

t.test(CN ~ Species, data = InitialChem)
t.test(PercNit ~ Species, data = InitialChem)
t.test(PB ~ Species, data = InitialChem)
t.test(AB ~ Species, data = InitialChem)


chem_summary <- InitialChem %>%
  group_by(Species,Park) %>%
  summarise(
    n = n(),
    
    mean_PercNit = mean(PercNit, na.rm = TRUE),
    se_PercNit = sd(PercNit, na.rm = TRUE) / sqrt(n),
    
    mean_CN = mean(CN, na.rm = TRUE),
    se_CN = sd(CN, na.rm = TRUE) / sqrt(n),
    
    mean_AB = mean(AB, na.rm = TRUE),
    se_AB = sd(AB, na.rm = TRUE) / sqrt(n),
    
    mean_PB = mean(PB, na.rm = TRUE),
    se_PB = sd(PB, na.rm = TRUE) / sqrt(n)
  )

chem_summary

